# References:
# https://htcondor.readthedocs.io/en/latest/admin-manual/configuration-macros.html#configuration-file-entries-for-dagman
# https://pegasus.isi.edu/documentation/reference-guide/configuration.html#properties

#pegasus.catalog.site.file=./conf/sites.yml

pegasus.data.configuration = nonsharedfs

# vortex has no Pegasus install: ship the worker package with the jobs
pegasus.transfer.worker.package = true

# staging site is on the compute site's shared filesystem: symlink inputs
# instead of copying them into the PegasusLite work dir
pegasus.transfer.links = true

#pegasus.catalog.replica  File
#pegasus.catalog.replica.file ./conf/rc.data

# Default: seqexec (or pegasus-cluster): Runs clustered small tasks sequentially or inside a single node environment.
pegasus.clusterer.job.aggregator seqexec

#cluster even single jobs on a level
pegasus.clusterer.allow.single True

pegasus.integrity.checking none

#pegasus.register False

dagman.retry = 0



