#https://htcondor.readthedocs.io/en/24.0/admin-manual/configuration-macros.html
GRIDMANAGER_DEBUG = D_FULLDEBUG D_GAHP
# Forces SSH to explicitly drop tty-allocation which dampens many profile echoes
REMOTE_GAHP_SSH_OPTS = -T -o LogLevel=DEBUG

# HTCondor config, then condor_reconfig:
SLURM_GAHP = /home/jovyan/.blahp-sshslurm/bin/blahpd
